{
  "name": "skybrisk-erp-system",
  "version": "1.0.0",
  "description": "Enterprise Resource Planning (ERP) System - MERN Stack",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "nodemon backend/server.js",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "seed": "node backend/seeder/seed.js",
    "test": "npm run test --prefix backend",
    "build": "npm run build --prefix frontend"
  },
  "keywords": [
    "erp",
    "mern",
    "react",
    "express",
    "mongodb",
    "nodejs",
    "inventory",
    "sales-orders",
    "purchase-orders",
    "grn",
    "invoicing"
  ],
  "author": "Abdur Rahman",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  }
}

